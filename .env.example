# ========================================================
# M07 – MSANIFU ZERO SEVEN PRODUCTION ENVIRONMENT CONFIG
# ========================================================

# 1. APPLICATION & DOMAIN URL (Your .com Domain)
# Example: https://m07carhire.com or https://msanifuzeroseven.com
APP_URL="https://m07carhire.com"

# 2. REAL SAFARICOM M-PESA DARAJA STK PUSH (REAL MONEY)
# Get credentials from https://developer.safaricom.co.ke
# For test use "sandbox", for real live money use "production"
MPESA_ENVIRONMENT="production"
MPESA_CONSUMER_KEY="your_safaricom_consumer_key_here"
MPESA_CONSUMER_SECRET="your_safaricom_consumer_secret_here"
MPESA_PASSKEY="your_safaricom_stk_passkey_here"
MPESA_SHORTCODE="807007" # Your Lipa Na M-Pesa Paybill or Buy Goods Till number

# 3. SUPABASE CLOUD DATABASE (PERSISTENT REAL BOOKINGS)
# Create a free project at https://supabase.com
# Find these in Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# 4. GEMINI AI API KEY (Optional server-side AI features)
GEMINI_API_KEY="your_gemini_api_key_here"
